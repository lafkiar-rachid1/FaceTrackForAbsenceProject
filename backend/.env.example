# Variables d'environnement pour l'application
# Copiez ce fichier en .env et modifiez les valeurs selon votre configuration

# Application
APP_NAME="FaceTrack Absence System"
APP_VERSION="1.0.0"
DEBUG=True

# Database PostgreSQL
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/facetrack_db

# JWT Secret Key
SECRET_KEY=your-super-secret-key-change-this-in-production-replace-with-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Origins (séparés par des virgules)
# Ajoutez les URLs de votre frontend
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# Face Recognition Configuration
DATASET_DIR=dataset
MODELS_DIR=models
ATTENDANCE_DIR=attendance
FACE_MODEL=Facenet
DETECTOR_BACKEND=opencv
MIN_IMAGES_FOR_TRAINING=10
MAX_IMAGES_PER_STUDENT=30

# Upload Configuration
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760  # 10 MB en bytes
