# Variables d'environnement pour le frontend React
# Copiez ce fichier en .env et modifiez les valeurs selon votre configuration

# Backend API URL
# En développement local:
VITE_API_URL=http://localhost:8000

# En production, remplacez par l'URL de votre backend:
# VITE_API_URL=https://api.votre-domaine.com

# Note: Les variables doivent commencer par VITE_ pour être accessibles dans Vite
